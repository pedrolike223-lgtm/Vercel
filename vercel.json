{
  "version": 2,
  "builds": [
    {
      "src": "api/contacts.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/analytics.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/contacts",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/api/analytics",
      "dest": "/api/analytics.js"
    }
  ]
}
